# Reference for every setting. In production these come from GitHub repo variables/secrets
# and are rendered to /etc/agents/sensi-agent.env on deploy; use this file for local runs.

# --- Required (see README: The Sensi login) ---
SENSI_CLIENT_ID=
SENSI_CLIENT_SECRET=
# Only a starting point: Sensi can replace it, and the newest one is kept in TOKENS_PATH.
# Setting a different value here (a new login) takes over from the saved one.
SENSI_REFRESH_TOKEN=

# --- What to notify about ---
# Any of: hvac_on (heat or AC started), hvac_off (it stopped), setpoint (set temperature changed), mode
NOTIFY_EVENTS=hvac_on,hvac_off,setpoint,mode
# Apprise URLs, comma separated: discord://webhook_id/webhook_token   ntfy://ntfy.sh/topic
NOTIFY_URLS=

# --- Problems (a thermostat offline, no data from the cloud) ---
# Reported after this long, then reminded every RENOTIFY_HOURS
OFFLINE_GRACE_MINUTES=15
RENOTIFY_HOURS=24

# --- Connection ---
# Reconnect for a full state when the cloud has sent nothing for this long (at least 30)
RESYNC_SECONDS=60

# Changes kept for the sensi_history bus tool
HISTORY_SIZE=500

# --- Heating cost (optional: see README, Heating cost) ---
# Your National Grid online account. Both empty turns the report off.
NATIONALGRID_USERNAME=
NATIONALGRID_PASSWORD=
# When the weekly report goes out, in the container's time zone
GAS_REPORT_DAY=sun
GAS_REPORT_HOUR=8

# Agent bus (MCP for an assistant such as Hermes): a long random token; empty turns it off
AGENT_BUS_TOKEN=
AGENT_BUS_PORT=8765
BOT_ALERT_URL=
